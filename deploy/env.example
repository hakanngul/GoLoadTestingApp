# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
GOLOAD_TOKEN=
GOLOAD_WORKER_TOKEN=

# Optional
# GOLOAD_IMAGE=123456789012.dkr.ecr.eu-central-1.amazonaws.com/goloadtest:v0.1.0
# GOLOAD_VERSION=dev
# GOLOAD_HTTP_PORT=8080
# GOLOAD_GRPC_PORT=9090

# AWS worker provisioning (docs/aws.md); filled in by Terraform on the master.
# GOLOAD_PROVISIONER=aws
# GOLOAD_MASTER_ADVERTISE_ADDR=10.0.1.15:9090
# GOLOAD_WORKER_IMAGE=123456789012.dkr.ecr.eu-central-1.amazonaws.com/goloadtest:v0.1.0
# GOLOAD_AWS_REGION=eu-central-1
# GOLOAD_AWS_LAUNCH_TEMPLATE_ID=lt-0123456789abcdef0
# GOLOAD_AWS_SUBNET_IDS=subnet-aaa,subnet-bbb
# GOLOAD_AWS_INSTANCE_TYPES=c7i.large,c6i.large,c5.large
# GOLOAD_AWS_SPOT_ONLY=false
# GOLOAD_AWS_MAX_PRICE=
